#!/usr/bin/env bash
set -euo pipefail
# Herdr's name grammar is ASCII. Keep shell range matching deterministic on
# macOS, whose default locale may collate uppercase letters inside [a-z].
export LC_ALL=C
: "${FAKE_HERDR_ROOT:?}"
mkdir -p "$FAKE_HERDR_ROOT"
{
  printf 'CALL'
  for arg in "$@"; do printf '\t%s' "$arg"; done
  printf '\n'
} >> "${FAKE_HERDR_LOG:-$FAKE_HERDR_ROOT/argv.log}"

if [ -n "${FAKE_HERDR_FAIL_MATCH:-}" ]; then
  case " $* " in *"$FAKE_HERDR_FAIL_MATCH"*) printf '%s\n' "${FAKE_HERDR_FAIL_TEXT:-forced failure}"; exit "${FAKE_HERDR_FAIL_RC:-1}" ;; esac
fi
if [ -n "${FAKE_HERDR_BUSY_ONCE_MATCH:-}" ]; then
  case " $* " in
    *"$FAKE_HERDR_BUSY_ONCE_MATCH"*)
      busy="$FAKE_HERDR_ROOT/busy-once"
      if [ ! -e "$busy" ]; then : > "$busy"; echo agent_pane_busy; exit 1; fi
      ;;
  esac
fi

if [ "${1:-}" = --session ]; then shift 2; fi

# Match Herdr's real agent-name contract so tests cannot accept identities that
# production rejects: 1-32 lowercase letters, digits, dashes, or underscores.
if [ "${1:-}" = agent ] && [ "${2:-}" = start ]; then
  agent_name="${3:-}"
  case "$agent_name" in
    ''|*[!a-z0-9_-]*) echo invalid_agent_name; exit 1 ;;
  esac
  [ "${#agent_name}" -le 32 ] || { echo invalid_agent_name; exit 1; }
fi

key="${1:-}"
[ $# -gt 0 ] && shift
for arg in "$@"; do key="$key.$arg"; done
key="$(printf '%s' "$key" | tr '/ ' '__')"

# The full argv key remains human-readable for configured fake responses, but it
# can contain long temp paths and passthrough arguments. Hash only the internal
# invocation counter so its basename stays below filesystem limits on macOS.
counter_key="$(FAKE_HERDR_COUNTER_KEY="$key" python3 - <<'PY'
import hashlib, os
print(hashlib.sha256(os.environ["FAKE_HERDR_COUNTER_KEY"].encode()).hexdigest())
PY
)"
count_file="$FAKE_HERDR_ROOT/count.$counter_key"
count=0; [ -f "$count_file" ] && count="$(cat "$count_file")"
count=$((count + 1)); printf '%s\n' "$count" > "$count_file"
if [ -f "$FAKE_HERDR_ROOT/$key.$count.rc" ]; then
  [ -f "$FAKE_HERDR_ROOT/$key.$count.out" ] && cat "$FAKE_HERDR_ROOT/$key.$count.out"
  exit "$(cat "$FAKE_HERDR_ROOT/$key.$count.rc")"
fi
if [ -f "$FAKE_HERDR_ROOT/$key.rc" ]; then
  [ -f "$FAKE_HERDR_ROOT/$key.out" ] && cat "$FAKE_HERDR_ROOT/$key.out"
  exit "$(cat "$FAKE_HERDR_ROOT/$key.rc")"
fi

case "${1:-}" in
  list) ;;
esac
case "$key" in
  session.list.--json) printf '{"sessions":[{"name":"test","socket_path":"%s"}]}\n' "$FAKE_HERDR_SOCKET" ;;
  tab.create.*) printf '{"result":{"root_pane":{"pane_id":"p1","tab_id":"t1"},"tab_id":"t1"}}\n' ;;
  agent.get.*)
    # Mirror real herdr 0.8.x: harness under .result.agent.agent, plus
    # agent_status and interactive_ready on the same object.
    pane="${key#agent.get.}"
    if [ -f "$FAKE_HERDR_ROOT/status.$pane" ]; then
      kind=""; [ -f "$FAKE_HERDR_ROOT/kind.$pane" ] && kind="$(cat "$FAKE_HERDR_ROOT/kind.$pane")"
      ready=false; [ -f "$FAKE_HERDR_ROOT/ready.$pane" ] && ready="$(cat "$FAKE_HERDR_ROOT/ready.$pane")"
      seq=""; [ -f "$FAKE_HERDR_ROOT/seq.$pane" ] && seq="$(cat "$FAKE_HERDR_ROOT/seq.$pane")"
      session=""; [ -f "$FAKE_HERDR_ROOT/session.$pane" ] && session="$(cat "$FAKE_HERDR_ROOT/session.$pane")"
      FAKE_KIND="$kind" FAKE_STATUS="$(cat "$FAKE_HERDR_ROOT/status.$pane")" FAKE_READY="$ready" FAKE_PANE="$pane" FAKE_SEQ="${seq:-null}" FAKE_SESSION="$session" python3 - <<'PY'
import json, os
agent={"agent":os.environ["FAKE_KIND"],"agent_status":os.environ["FAKE_STATUS"],"interactive_ready":os.environ["FAKE_READY"]=="true","pane_id":os.environ["FAKE_PANE"],"state_change_seq":None if os.environ["FAKE_SEQ"]=="null" else int(os.environ["FAKE_SEQ"])}
if os.environ["FAKE_SESSION"]: agent["agent_session"]={"agent":"pi","kind":"path","source":"herdr:pi","value":os.environ["FAKE_SESSION"]}
print(json.dumps({"result":{"type":"agent_info","agent":agent}},separators=(",",":")))
PY
    else exit 1; fi ;;
  pane.get.*) exit 1 ;;
  *) printf '{"result":{}}\n' ;;
esac
