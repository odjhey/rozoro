#!/usr/bin/env bash
# rozoro - checkout-local dispatcher: `./bin/rozoro <verb> [args]` runs `rzr-<verb>.sh`.
#
# Usage:
#   ./bin/rozoro <verb> [args...]     e.g. `./bin/rozoro start t1 --body b.txt --cwd .`
#   ./bin/rozoro help | -h | --help   list verbs
#
# Every rzr-<verb>.sh in this bin/ is a verb (except the sourced-only rzr-lib.sh).
# The rzr-*.sh scripts remain first-class; this is just a nicer front door. A
# `rzr` symlink to this file gives the short form `rzr <verb>`.
set -euo pipefail
BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

verb="${1:-help}"
case "$verb" in
  help|-h|--help)
    echo "usage: ./bin/rozoro <verb> [args...]"
    echo "verbs:"
    echo "  monitor start|status|stop   resident Pi+Claude event-bus authority"
    echo "  reconcile [--driver ID]    consume and ACK a daemon generation"
    echo "  watch ...                  diagnostics/legacy compatibility only"
    for f in "$BIN"/rzr-*.sh; do
      b="$(basename "$f" .sh)"; b="${b#rzr-}"
      case "$b" in lib|monitor|reconcile|watch) continue ;; esac
      printf '  %s\n' "$b"
    done
    exit 0 ;;
esac

target="$BIN/rzr-$verb.sh"
{ [ -f "$target" ] && [ "$verb" != "lib" ]; } || {
  echo "rozoro: unknown verb '$verb' (try: ./bin/rozoro help)" >&2; exit 1; }
shift
exec "$target" "$@"
